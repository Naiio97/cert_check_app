<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverzní proxy IIS -> Waitress (port 8080). Patří do složky IIS aplikace "evidence_certifikatu"
  (ve složce aplikace; update.bat tento soubor při aktualizaci nepřepisuje).

  Windows přihlášení: IIS ověří uživatele a jeho účet pošle aplikaci v hlavičce X-Remote-User.
  Podmínky (viz DEPLOY.md, kapitola 10):
    - u IIS aplikace je Anonymous Authentication vypnutá a Windows Authentication zapnutá
    - proměnná HTTP_X_REMOTE_USER je povolená v allowedServerVariables (appcmd z DEPLOY.md)
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Statické soubory -->
                <rule name="Static Files" stopProcessing="true">
                    <match url="^static/(.*)$" />
                    <serverVariables>
                        <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://localhost:8080/evidence_certifikatu/static/{R:1}" />
                </rule>
                <!-- Všechno ostatní. Pravidlo hlavičku vždy přepíše, takže ji klient nemůže podvrhnout. -->
                <rule name="Flask Reverse Proxy" stopProcessing="true">
                    <match url="(.*)" />
                    <serverVariables>
                        <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://localhost:8080/evidence_certifikatu/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
