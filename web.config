<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverzní proxy IIS -> Waitress (port 8080). Patří do složky IIS aplikace "evidence_certifikatu"
  (ve složce aplikace; update.bat tento soubor při aktualizaci nepřepisuje).

  Windows přihlášení: IIS ověří uživatele a modul RemoteUserModule (bin\RemoteUserModule.dll,
  zdroj v iis\RemoteUserModule.cs, sestavení iis\build-module.ps1) vloží jeho účet do hlavičky X-Remote-User.
  Pravidlo URL Rewrite s {LOGON_USER} se na to použít nedá — vyhodnotí se dřív, než je uživatel ověřen.

  Podmínky (viz DEPLOY.md, kapitola 10):
    - u IIS aplikace je Anonymous Authentication vypnutá a Windows Authentication zapnutá
    - na serveru je ASP.NET 4.x (Web-Asp-Net45) a application pool má .NET CLR v4.0 + Integrated pipeline
-->
<configuration>
    <system.webServer>
        <modules>
            <remove name="RemoteUserModule" />
            <!-- preCondition="" = modul běží i pro požadavky, které nejdou přes ASP.NET (proxy na Waitress) -->
            <add name="RemoteUserModule" type="RemoteUserModule" preCondition="" />
        </modules>
        <rewrite>
            <rules>
                <!-- Statické soubory -->
                <rule name="Static Files" stopProcessing="true">
                    <match url="^static/(.*)$" />
                    <action type="Rewrite" url="http://localhost:8080/evidence_certifikatu/static/{R:1}" />
                </rule>
                <!-- Všechno ostatní -->
                <rule name="Flask Reverse Proxy" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:8080/evidence_certifikatu/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
