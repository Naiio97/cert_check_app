# Bezpečnostní klíč pro Flask sessions
SECRET_KEY=vygenerujte-pomoci-python-c-import-secrets-print(secrets.token_hex(32))

# Debug režim (true pouze pro vývoj, nikdy ne v produkci)
FLASK_DEBUG=false

# Email konfigurace
MAIL_SERVER=smtp.example.com
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_SMTP_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_ADDRESS=noreply@example.com
MAIL_SENDER_NAME=Správa certifikátů
MAIL_SUBJECT_PREFIX=[CERT]
MAIL_RECIPIENTS=admin@example.com
# Odkaz pro tlačítko v e-mailech, např. https://server.firma.cz:8080/evidence_certifikatu (prázdné = bez tlačítka)
APP_URL=

# Reporty — fallback, primárně se nastavuje v aplikaci (Nastavení → Měsíční reporty).
# Hodnoty uložené v DB mají přednost před těmito.
# Každé další prostředí se odesílá s odstupem 5 minut.
REPORT_ENVS=live,uat,sit,prelive
REPORT_DAY=1
REPORT_HOUR=9
REPORT_MINUTE=0

# ── Přihlášení a role (viz DEPLOY.md, kapitola 10) ──
# Windows SSO zajišťuje IIS (hlavička X-Remote-User); role přiděluje admin v aplikaci.
AUTH_ENABLED=true
AUTH_REMOTE_USER_HEADER=X-Remote-User
AUTH_TRUSTED_PROXIES=127.0.0.1,::1
# První administrátoři (doménové účty, čárkou oddělené)
ADMIN_USERS=
# Záložní lokální admin (bez hashe je vypnutý); hash: viz DEPLOY.md
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD_HASH=
# Jen pro vývoj bez IIS: simulovaný doménový účet pro localhost
AUTH_DEV_USER=
